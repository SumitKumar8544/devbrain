# DevBrain Environment Variables Template
PORT=5000

# AI Copilot Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Storage (Persistent Photos, Documents, PDFs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_publishable_key
SUPABASE_BUCKET=vault

# MongoDB Atlas (Cloud User Authentication & Login)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/devbrain?retryWrites=true&w=majority
